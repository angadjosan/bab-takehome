# Runtime image for humanevalfix-8: Python 3.12 + pinned pytest, nothing else.
# The environment bundle itself is mounted read-only at /env at run time; this
# image carries no task content. Run it offline, e.g.:
#   docker run --rm --network none --read-only --tmpfs /tmp:rw,nosuid,nodev,size=256m \
#     --cpus 1 --memory 512m --pids-limit 128 --security-opt no-new-privileges --cap-drop ALL \
#     -v "$PWD:/env:ro" humanevalfix-8-runner:local python -m grader.env serve
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=UTC \
    LC_ALL=C.UTF-8 \
    TMPDIR=/tmp

COPY requirements.lock /tmp/requirements.lock
RUN python -m pip install --require-hashes --only-binary=:all: -r /tmp/requirements.lock \
 && rm /tmp/requirements.lock \
 && useradd --uid 10001 --user-group --no-create-home --home-dir /tmp --shell /usr/sbin/nologin runner

USER 10001:10001
WORKDIR /env
CMD ["python", "-m", "grader.env", "serve"]
