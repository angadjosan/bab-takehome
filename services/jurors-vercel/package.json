{
  "name": "@envmarket/jurors-vercel",
  "version": "0.1.0",
  "private": true,
  "description": "The three EnvMarket AI jurors as Vercel Functions + Vercel Workflow (event-driven, durable commit-reveal)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "sync": "node scripts/sync-vendor.mjs",
    "sync:check": "node scripts/sync-vendor.mjs --check",
    "test": "node scripts/sync-vendor.mjs --check && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.4",
    "openai": "^7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.3",
    "workflow": "4.8.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
